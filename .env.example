# ==============================================================================
# ReferralPilot AI - Environment Configuration Template
# Copy this file to .env for local development. NEVER commit .env to Git.
# ==============================================================================

# --- Application ---
APP_NAME=ReferralPilot AI
ENVIRONMENT=development
DEBUG=false
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security & Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@referralpilot.app
ADMIN_PASSWORD=ChangeMeStrongPassword123!

# --- Database (Supabase PostgreSQL in production) ---
# Production example: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Local dev/test fallback if PostgreSQL is not running locally: sqlite+pysqlite:///./referralpilot_dev.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/referralpilot

# --- AI / LLM Provider (Provider-Independent) ---
# Supported: openai | gemini | heuristic
LLM_PROVIDER=heuristic
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_USER_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret

# --- Discovery & Scheduler ---
SCHEDULER_TIMEZONE=Asia/Kolkata
DISCOVERY_REQUEST_TIMEOUT_SECONDS=15
DISCOVERY_MAX_ITEMS_PER_SOURCE=25
HIGH_MATCH_THRESHOLD=75
CRON_API_SECRET=change-me-cron-shared-secret

# --- Frontend Build Variable (used by Vite) ---
VITE_API_BASE_URL=http://localhost:8000
